  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd904c20146f09a4081a324aa2a577d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteItem
  displayName: Notiz
  noteContent: "Dienst\xFCbergabe\r\nWillkommen im Nachtdienst, Geb\xE4ude SL. Bitte
    M\xFCll wegr\xE4umen und bitte die T\xFCren abschlie\xDFen. Der Plan h\xE4ngt
    im ersten Stock. Falls der Strom weg ist, der Stromkasten ist im Keller. Im Keller
    wird gerade an den neuen Leitungen gearbeitet \u2014 der Boden ist teils aufgerissen.
    Bitte nicht anfassen. Ich bin die n\xE4chsten Wochen weg. Ach ja: Wenn in SL-105
    Licht brennt, einfach ausmachen.\r\n\u2014 M."
  objectiveId: node
